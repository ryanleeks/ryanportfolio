---
import { site } from '../data/site';

/**
 * Form is intentionally NOT wired to a backend yet.
 * To enable it later: set `endpoint` (e.g. a Web3Forms / Formspree URL), add that origin to
 * `form-action` / `connect-src` in astro.config.mjs (security.csp), and handle the POST in src/scripts/contact-form.ts.
 */
const endpoint: string | undefined = undefined;
const projectTypes = ['Consultation', 'Floor plans', 'Construction', 'Full design & build'];
---

<form id="contact-form" class="space-y-6" novalidate data-endpoint={endpoint}>
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="firstName" class="mb-2 block text-sm font-medium">First name</label>
      <input class="field" id="firstName" name="firstName" type="text" autocomplete="given-name" required maxlength="80" />
    </div>
    <div>
      <label for="lastName" class="mb-2 block text-sm font-medium">Last name</label>
      <input class="field" id="lastName" name="lastName" type="text" autocomplete="family-name" required maxlength="80" />
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="email" class="mb-2 block text-sm font-medium">Email</label>
      <input class="field" id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" />
    </div>
    <div>
      <label for="phone" class="mb-2 block text-sm font-medium">Phone <span class="text-muted font-normal">(optional)</span></label>
      <input class="field" id="phone" name="phone" type="tel" autocomplete="tel" maxlength="20" pattern="[0-9+\-\s()]{7,20}" placeholder="+60 12-345 6789" />
    </div>
  </div>

  <div>
    <label for="city" class="mb-2 block text-sm font-medium">City</label>
    <select class="field appearance-none" id="city" name="city" required>
      <option value="" selected disabled>Select your city</option>
      {site.serviceAreas.map((c) => <option>{c}</option>)}
      <option>Other</option>
    </select>
  </div>

  <fieldset>
    <legend class="mb-3 text-sm font-medium">I'm interested in</legend>
    <div class="flex flex-wrap gap-2">
      {
        projectTypes.map((t) => (
          <label class="border-line has-checked:bg-ink has-checked:text-canvas has-checked:border-ink has-focus-visible:outline-brand cursor-pointer rounded-full border px-4 py-2 text-sm transition has-focus-visible:outline-2 has-focus-visible:outline-offset-2">
            <input type="checkbox" name="interest" value={t} class="sr-only" />
            {t}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div>
    <label for="message" class="mb-2 block text-sm font-medium">Tell us about your project</label>
    <textarea class="field min-h-40 resize-y" id="message" name="message" required minlength="10" maxlength="4000" placeholder="Property type, size, timeline, ideas…"></textarea>
  </div>

  <!-- Honeypot: hidden from people, tempting for bots -->
  <div class="hidden" aria-hidden="true">
    <label for="website">Website</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <button type="submit" class="btn-primary justify-center">Send enquiry <span aria-hidden="true">→</span></button>
    <p id="form-status" class="text-sm" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm();
</script>
