---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  priority?: boolean;
}
const { project, priority = false } = Astro.props;
const p = project.data;
---

<article class="group" data-reveal>
  <a href={`/projects/${project.id}`} class="block">
    <div class="overflow-hidden rounded-3xl">
      <Image
        src={p.cover}
        alt={p.coverAlt}
        widths={[600, 900, 1400]}
        sizes="(min-width: 768px) 50vw, 100vw"
        class="aspect-4/3 w-full object-cover transition duration-1000 ease-out group-hover:scale-[1.04]"
        loading={priority ? 'eager' : 'lazy'}
      />
    </div>
    <div class="mt-6 flex items-start justify-between gap-6">
      <div>
        <p class="eyebrow">{p.location} · {p.year}</p>
        <h3 class="mt-3 text-3xl md:text-4xl">{p.title}</h3>
        <p class="text-muted mt-2">{p.concept} · {p.size}</p>
      </div>
      <span class="border-line group-hover:bg-ink group-hover:text-canvas mt-1 inline-flex size-12 shrink-0 items-center justify-center rounded-full border transition duration-300" aria-hidden="true">→</span>
    </div>
  </a>
</article>
