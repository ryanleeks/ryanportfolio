---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { site, yearsActive } from '../data/site';
import hero from '../assets/projects/the-mines/the-mines-49.jpg';
import aboutImg from '../assets/projects/kota-damansara/kota-damansara-05.jpg';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const totalSqft = projects.reduce((sum, p) => sum + Number(p.data.size.replace(/[^\d]/g, '')), 0);

const stats = [
  { value: `${yearsActive}+`, label: 'Years of practice' },
  { value: `${(totalSqft / 1000).toFixed(1)}k`, label: 'Sq ft in featured homes' },
  { value: String(services.length), label: 'Services, one studio' },
];
---

<Base overlayHeader>
  <!-- Hero -->
  <section class="relative isolate flex min-h-svh items-end overflow-hidden text-white">
    <Image
      src={hero}
      alt="The Mines bungalow at dusk, designed by Calic Design"
      widths={[800, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/85 via-black/30 to-black/40"></div>
    <div class="container-x pt-32 pb-16 md:pb-24">
      <p class="text-sand text-xs font-semibold tracking-[0.3em] uppercase" data-reveal>Interior design &amp; build · Since {site.founded}</p>
      <h1 class="mt-6 max-w-5xl text-5xl leading-[0.98] [--reveal-delay:100ms] sm:text-7xl lg:text-8xl" data-reveal>
        Timeless homes, <em class="text-sand font-light">thoughtfully</em> crafted.
      </h1>
      <div class="mt-10 flex flex-col gap-8 [--reveal-delay:200ms] md:flex-row md:items-end md:justify-between" data-reveal>
        <p class="max-w-md text-lg leading-relaxed text-white/80">
          We transform houses into works of art — from the first consultation to the final finish.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/projects" class="btn-light">View projects <span aria-hidden="true">→</span></a>
          <a href="/contact" class="btn border border-white/40 text-white hover:bg-white/10">Start a project</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Intro + stats -->
  <section class="container-x grid gap-14 py-24 md:py-32 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow" data-reveal>About the studio</p>
      <h2 class="mt-5 text-4xl leading-tight [--reveal-delay:80ms] md:text-6xl" data-reveal>
        {yearsActive} years of experience. And we keep on going.
      </h2>
      <p class="text-muted mt-8 max-w-xl text-lg leading-relaxed [--reveal-delay:160ms]" data-reveal>
        Established in {site.founded}, Calic Design creates refined interior concepts that turn your dream home into a
        lasting work of art — paired with the craftsmanship to build it.
      </p>
      <a href="/about" class="btn-ghost mt-10 [--reveal-delay:200ms]" data-reveal>Our story <span aria-hidden="true">→</span></a>
    </div>
    <div class="lg:col-span-5" data-reveal>
      <Image src={aboutImg} alt="Living room by Calic Design with black leather sofas and an illuminated display wall" widths={[500, 900]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-4/5 w-full rounded-3xl object-cover" />
    </div>
    <dl class="border-line grid gap-10 border-t pt-12 sm:grid-cols-3 lg:col-span-12">
      {
        stats.map((s) => (
          <div data-reveal>
            <dt class="text-muted text-sm">{s.label}</dt>
            <dd class="font-display mt-2 text-5xl md:text-6xl">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Projects -->
  <section class="bg-surface border-line border-y py-24 md:py-32">
    <div class="container-x">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow" data-reveal>Selected work</p>
          <h2 class="mt-5 text-4xl [--reveal-delay:80ms] md:text-6xl" data-reveal>Professionally designed.</h2>
        </div>
        <a href="/projects" class="link-underline self-start text-sm font-medium md:self-auto" data-reveal>All projects →</a>
      </div>
      <div class="mt-14 grid gap-14 md:grid-cols-2 md:gap-10">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="container-x py-24 md:py-32">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>What we do</p>
      <h2 class="mt-5 text-4xl [--reveal-delay:80ms] md:text-6xl" data-reveal>Exceptional service, curated for you.</h2>
      <p class="text-muted mt-6 text-lg leading-relaxed [--reveal-delay:160ms]" data-reveal>
        From the first conversation to the last coat of paint — one team, one point of contact.
      </p>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {services.map((service, i) => <ServiceCard service={service} index={i} />)}
    </div>
  </section>

  <CtaBanner />
</Base>
