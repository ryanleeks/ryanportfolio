---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { site, yearsActive } from '../data/site';
import wide from '../assets/projects/the-mines/the-mines-23.jpg';
import detail from '../assets/projects/kota-damansara/kota-damansara-16.jpg';

const values = [
  {
    title: 'Timeless design',
    body: 'Architecture and interiors designed to age gracefully — not to chase trends.',
  },
  {
    title: 'Exceptional service',
    body: 'A close collaboration between you and our designers, curated around how you live.',
  },
  {
    title: 'Design & build',
    body: 'Consultation, floor plans and construction under one roof, held to one standard.',
  },
];
---

<Base title="About" description={`Established in ${site.founded}, Calic Design has spent ${yearsActive} years crafting timeless residential interiors in Malaysia.`}>
  <PageHeader
    eyebrow="About us"
    title={`${yearsActive} years of experience. Keep on going.`}
    lede={`Established in ${site.founded}, Calic Design creates exquisite interior design concepts that transform your dream home into a work of art.`}
  />

  <section class="container-x" data-reveal>
    <Image src={wide} alt="Indoor pool and glass-walled living area at The Mines" widths={[800, 1400, 2200]} sizes="100vw" class="aspect-video w-full rounded-3xl object-cover md:aspect-21/9" loading="eager" />
  </section>

  <section class="container-x grid gap-14 py-24 md:grid-cols-12 md:py-32">
    <div class="md:col-span-5" data-reveal>
      <Image src={detail} alt="Backlit onyx feature wall and dining area in Kota Damansara" widths={[500, 900]} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-4/5 w-full rounded-3xl object-cover" />
    </div>
    <div class="space-y-6 text-lg leading-relaxed md:col-span-6 md:col-start-7 md:self-center">
      <p class="eyebrow" data-reveal>Our story</p>
      <p class="font-display text-3xl leading-snug md:text-4xl" data-reveal>
        Excellent, timeless design — and the service to match.
      </p>
      <p class="text-muted" data-reveal>
        We design architecture and interiors that last, while providing exceptional service that meets your needs. Our work
        has earned the trust of many clients, who value the skill, experience and knowledge we bring to every home.
      </p>
      <p class="text-muted" data-reveal>
        Calic Design will continue to serve every client who truly values the craft — just as we have since {site.founded}.
      </p>
    </div>
  </section>

  <section class="bg-surface border-line border-y py-24">
    <div class="container-x">
      <p class="eyebrow" data-reveal>What we stand for</p>
      <ul class="mt-12 grid gap-12 md:grid-cols-3">
        {
          values.map((v, i) => (
            <li data-reveal class="border-line border-t pt-8">
              <p class="text-brand-ink font-display text-sm">{String(i + 1).padStart(2, '0')}</p>
              <h2 class="mt-3 text-2xl">{v.title}</h2>
              <p class="text-muted mt-3 leading-relaxed">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBanner />
</Base>
