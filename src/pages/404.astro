---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you're looking for doesn't exist.">
  <section class="container-x flex min-h-[60vh] flex-col items-start justify-center py-24">
    <p class="eyebrow">Error 404</p>
    <h1 class="mt-5 text-6xl md:text-8xl">This room doesn't exist.</h1>
    <p class="text-muted mt-6 max-w-md text-lg">The page you're looking for may have moved. Let's get you back home.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/projects" class="btn-ghost">View projects</a>
    </div>
  </section>
</Base>
